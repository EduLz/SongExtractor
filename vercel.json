{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/spotify/playlist/:playlist_id",
      "destination": "/api/spotify/playlist.py?playlist_id=:playlist_id"
    },
    {
      "source": "/api/spotify/playlist",
      "destination": "/api/spotify/playlist.py"
    },
    {
      "source": "/api/ytmusic/search",
      "destination": "/api/ytmusic/search.py"
    },
    {
      "source": "/api/ytmusic/add",
      "destination": "/api/ytmusic/add.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
